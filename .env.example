# ---- Paths ----
RAG_PAPERS_DIR=data/papers
RAG_INDEX_DIR=data/index

# ---- Chunking ----
RAG_CHUNK_TOKENS=400          # MUST stay under the embedding model's 512-token limit
                              # (bge-small-en-v1.5 truncates silently above it)
RAG_CHUNK_OVERLAP=0.15        # fractional overlap between sibling chunks
RAG_MIN_CHUNK_TOKENS=50       # drop fragments smaller than this

# ---- Embeddings ----
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBED_BATCH=32
# bge models are asymmetric: queries need an instruction prefix, passages do not.
RAG_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# ---- Vector store ----
RAG_STORE=numpy               # numpy | chroma

# ---- Retrieval ----
RAG_RETRIEVER=hybrid          # dense | bm25 | hybrid | rerank
                              # Measured on the gold set (docs/evaluation.md):
                              #   dense           Hit@5 78.6%  P@1 57.1%  MRR 0.645
                              #   bm25            Hit@5 92.9%  P@1 57.1%  MRR 0.729
                              #   hybrid (RRF)    Hit@5 92.9%  P@1 78.6%  MRR 0.818  <-- best
                              #   hybrid+rerank   Hit@5 85.7%  P@1 57.1%  MRR 0.660 (100x slower)
RAG_TOP_K=5                   # chunks passed to the LLM
RAG_RRF_K=5                   # Reciprocal Rank Fusion damping constant.
                              # The literature default of 60 is tuned for
                              # web-scale corpora and underperforms here:
                              #   K=60  Hit@5 85.7%  MRR 0.821
                              #   K=5   Hit@5 92.9%  MRR 0.839  <-- measured best
RAG_CANDIDATES=20             # candidates fetched before fusion/rerank
RAG_MIN_SCORE=0.58            # confidence gate; below this -> abstain without an LLM call.
                              # Calibrated on this corpus (bge-small cosine):
                              #   in-corpus  0.83-0.85
                              #   near-miss  0.61-0.66  (let through; Gate 2 handles these)
                              #   gibberish  0.56
                              #   off-topic  0.50
                              # 0.58 rejects off-topic/gibberish cheaply while
                              # leaving genuinely ambiguous queries to the model.

# ---- Generation (Ollama, local) ----
RAG_LLM_BACKEND=ollama
RAG_OLLAMA_HOST=http://localhost:11434
RAG_OLLAMA_MODEL=llama3.2:3b  # swap to gemma4:12b for a slower, higher-quality run
RAG_LLM_TEMPERATURE=0.0
RAG_LLM_MAX_TOKENS=512
RAG_LLM_TIMEOUT=300
